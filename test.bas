Rem ============================================================================
Rem test.bas - Comprehensive Validation & Reference Guide for sbasic
Rem Tests ALL implemented operators, statements, built-in functions,
Rem Linear Algebra (linalg.cpp), Calc Functions (calc.*), and Office I/O (liboffice.cpp).
Rem Generates validation.txt with full output and explanations, and cleans up all temp files.
Rem ============================================================================

Option Explicit
Option Base 0

Global gLogCh As Integer
Global gPassCount As Integer
Global gTotalCount As Integer
Global gSectionCount As Integer
Global gGlobalTestVar As String

Sub LogLine(ByVal txt As String)
    Print txt
    If gLogCh > 0 Then
        Print #gLogCh, txt
    End If
End Sub

Sub LogHeader(ByVal title As String, ByVal desc As String)
    gSectionCount = gSectionCount + 1
    If gSectionCount > 1 Then
        LogLine("")
        LogLine("[Pausing 1000 ms before next test section...]")
        Wait(1000)
    End If
    LogLine("================================================================================")
    LogLine("SECTION " & CStr(gSectionCount) & ": " & title)
    LogLine("Explanation: " & desc)
    LogLine("================================================================================")
End Sub

Sub CheckVal(ByVal syntaxStr As String, ByVal explainStr As String, ByVal actualVal As Variant, ByVal expectedVal As Variant)
    gTotalCount = gTotalCount + 1
    Dim status As String
    If CStr(actualVal) = CStr(expectedVal) Then
        status = "[PASS]"
        gPassCount = gPassCount + 1
    Else
        status = "[FAIL] (Expected: " & CStr(expectedVal) & ")"
    End If
    Dim lineOut As String
    lineOut = "  " & RPad(status, 8, " ") & RPad(syntaxStr, 38, " ") & " => " & RPad(CStr(actualVal), 22, " ") & " | " & explainStr
    LogLine(lineOut)
End Sub

Sub CheckNum(ByVal syntaxStr As String, ByVal explainStr As String, ByVal actualNum As Double, ByVal expectedNum As Double, ByVal tol As Double)
    gTotalCount = gTotalCount + 1
    Dim status As String
    If Abs(actualNum - expectedNum) <= tol Then
        status = "[PASS]"
        gPassCount = gPassCount + 1
    Else
        status = "[FAIL] (Expected: " & CStr(expectedNum) & ")"
    End If
    Dim fmtAct As String
    fmtAct = Format(actualNum, "0.######")
    Dim lineOut As String
    lineOut = "  " & RPad(status, 8, " ") & RPad(syntaxStr, 38, " ") & " => " & RPad(fmtAct, 22, " ") & " | " & explainStr
    LogLine(lineOut)
End Sub

Function TestByValByRef(ByVal a As Integer, ByRef b As Integer) As Integer
    a = a + 100
    b = b + 100
    If a > 1000 Then Exit Function
    TestByValByRef = a + b
End Function

Sub HelperMultiply(ByVal x As Double, ByRef outRes As Double)
    If x < 0 Then Exit Sub
    outRes = x * 2.5
End Sub

Function ZeroParamFunc() As String
    ZeroParamFunc = "OK_NO_ARGS"
End Function

Sub Main()
    gPassCount = 0
    gTotalCount = 0
    gSectionCount = 0

    gLogCh = FreeFile
    Open "validation.txt" For Output As #gLogCh

    LogLine("********************************************************************************")
    LogLine("*        SBASIC STANDALONE INTERPRETER - FULL VALIDATION & USER GUIDE          *")
    LogLine("********************************************************************************")
    LogLine("This file (validation.txt) was automatically generated by test.bas.")
    LogLine("It serves as both an automated verification report and a complete syntax")
    LogLine("and behavior guide for all implemented operands, statements, and functions.")
    LogLine("")

    Rem ========================================================================
    Rem SECTION 1 - OPERANDS, OPERATORS, CONSTANTS & DATA TYPES
    Rem ========================================================================
    LogHeader("OPERANDS, OPERATORS, CONSTANTS & DATA TYPES", _
              "Arithmetic (+, -, *, /, \, ^, Mod), String (&, +), Comparison (=, <>, <, >, <=, >=), Logical (Not, And, Or), Constants (True, False, Pi), and Type Suffixes (%, $).")

    Dim iA% : iA% = 15
    Dim iB As Integer : iB = 4
    Dim dA As Double : dA = 15.0
    Dim dB As Single : dB = 4.0
    Dim sA$ : sA$ = "Star"
    Dim sB As String : sB = "Basic"
    Dim vVar As Variant : vVar = 42
    Public pubVar As Integer : pubVar = 7
    Private privVar As Integer : privVar = 9
    gGlobalTestVar = "GlobalOK"

    CheckVal("15 + 4", "Addition operator (+)", iA% + iB, 19)
    CheckVal("15 - 4", "Subtraction operator (-)", iA% - iB, 11)
    CheckVal("15 * 4", "Multiplication operator (*)", iA% * iB, 60)
    CheckNum("15.0 / 4.0", "Floating-point division operator (/)", dA / dB, 3.75, 1e-9)
    CheckVal("15 \ 4", "Integer division operator (\)", iA% \ iB, 3)
    CheckNum("2 ^ 5", "Exponentiation / Power operator (^)", 2 ^ 5, 32.0, 1e-9)
    CheckVal("15 Mod 4", "Modulo remainder operator (Mod)", iA% Mod iB, 3)
    CheckVal("-iA% / +iB", "Unary minus (-) and unary plus (+)", -iA% + (+iB), -11)
    CheckVal("""Star"" & ""Basic""", "String concatenation with ampersand (&)", sA$ & sB, "StarBasic")
    CheckVal("""Star"" + ""Basic""", "String concatenation with plus (+)", sA$ + sB, "StarBasic")
    CheckVal("(15 = 15) / (15 = 4)", "Equality comparison operator (=)", (iA% = 15) & "/" & (iA% = 4), "-1/0")
    CheckVal("(15 <> 4)", "Inequality comparison operator (<>)", (iA% <> iB), -1)
    CheckVal("(4 < 15) / (15 > 4)", "Less-than (<) and Greater-than (>)", (iB < iA%) & "/" & (iA% > iB), "-1/-1")
    CheckVal("(4 <= 4) / (15 >= 15)", "Less-or-equal (<=) and Greater-or-equal (>=)", (4 <= iB) & "/" & (15 >= iA%), "-1/-1")
    CheckVal("Not False / Not True", "Logical negation operator (Not)", (Not False) & "/" & (Not True), "-1/0")
    CheckVal("True And True / True And False", "Logical conjunction operator (And)", (True And True) & "/" & (True And False), "-1/0")
    CheckVal("False Or True / False Or False", "Logical disjunction operator (Or)", (False Or True) & "/" & (False Or False), "-1/0")
    CheckVal("True / False", "Built-in boolean constants True (-1) and False (0)", True & "/" & False, "-1/0")
    CheckNum("Pi", "Built-in mathematical constant Pi", Pi, 3.14159265358979, 1e-9)
    CheckVal("Global / Public / Private / Variant", "Variable declarations & scopes", gGlobalTestVar & "/" & pubVar & "/" & privVar & "/" & vVar, "GlobalOK/7/9/42")

    Rem ========================================================================
    Rem SECTION 2 - CONTROL FLOW, LOOPS, BRANCHING, PROCEDURES & ERROR HANDLING
    Rem ========================================================================
    LogHeader("CONTROL FLOW, LOOPS, PROCEDURES & ERROR HANDLING", _
              "If/ElseIf/Else, Single-line If, Select Case (To, Is), For/Next (Step, Exit For), Do/Loop (While/Until, Exit Do), While/Wend, GoTo, GoSub/Return, Sub/Function (ByVal/ByRef), On Error GoTo/Resume.")

    Dim branchRes As String
    Dim xVal As Integer : xVal = 20
    If xVal < 10 Then
        branchRes = "Small"
    ElseIf xVal = 20 Then
        branchRes = "Exact20"
    Else
        branchRes = "Large"
    End If
    CheckVal("If ... ElseIf ... Else ... End If", "Multi-line conditional branching", branchRes, "Exact20")

    Dim singleIfRes As String : singleIfRes = "Init"
    If xVal = 20 Then singleIfRes = "SingleTrue" Else singleIfRes = "SingleFalse"
    CheckVal("If cond Then stmt Else stmt", "Single-line If/Then/Else execution", singleIfRes, "SingleTrue")

    Dim scOut As String : scOut = ""
    Dim scIdx As Integer
    For scIdx = 1 To 4
        Dim scVal As Integer : scVal = scIdx * 10
        Select Case scVal
            Case 10, 15
                scOut = scOut & "A"
            Case 20 To 30
                scOut = scOut & "B"
            Case Is > 35
                scOut = scOut & "C"
            Case Else
                scOut = scOut & "D"
        End Select
    Next scIdx
    CheckVal("Select Case (v1,v2 / To / Is >)", "Select Case pattern matching across ranges", scOut, "ABBC")

    Dim forSum As Integer : forSum = 0
    Dim k As Integer
    For k = 10 To 2 Step -2
        forSum = forSum + k
        If k = 4 Then Exit For
    Next k
    CheckVal("For k=10 To 2 Step -2 (Exit For)", "For/Next loop with negative Step and Exit For", forSum, 28)

    Dim wCount As Integer : wCount = 0
    While wCount < 4
        wCount = wCount + 1
    Wend
    CheckVal("While cond ... Wend", "Standard While/Wend loop", wCount, 4)

    Dim doA As Integer : doA = 0
    Do While doA < 5
        doA = doA + 1
        If doA = 3 Then Exit Do
    Loop
    Dim doB As Integer : doB = 0
    Do
        doB = doB + 2
    Loop Until doB >= 6
    CheckVal("Do While (Exit Do) / Loop Until", "Do/Loop pre-test and post-test variants", doA & "/" & doB, "3/6")

    Dim jumpTrace As String : jumpTrace = "Start"
    GoSub MySubLabel
    GoTo AfterGotoLabel
    jumpTrace = "Skipped"
AfterGotoLabel:
    jumpTrace = jumpTrace & "->End"
    GoTo DoneJumpTest
MySubLabel:
    jumpTrace = jumpTrace & "->InGosub"
    Return
DoneJumpTest:
    CheckVal("GoSub ... Return & GoTo label", "Subroutine label jump and unconditional GoTo", jumpTrace, "Start->InGosub->End")

    Dim argVal As Integer : argVal = 10
    Dim argRef As Integer : argRef = 20
    Dim fnRet As Integer
    fnRet = TestByValByRef(argVal, argRef)
    Dim subOut As Double : subOut = 0.0
    Call HelperMultiply(6.0, subOut)
    CheckVal("Sub / Function (ByVal vs ByRef)", "argVal unchanged (10), argRef modified (120)", argVal & "/" & argRef & "/" & fnRet & "/" & subOut, "10/120/230/15")
    CheckVal("ZeroParamFunc", "Calling zero-parameter Function without parens", ZeroParamFunc, "OK_NO_ARGS")

    Dim errCaughtCode As Integer : errCaughtCode = 0
    Dim errCaughtMsg As String : errCaughtMsg = ""
    Dim errCaughtLine As Integer : errCaughtLine = 0
    On Error GoTo MyErrorHandler
    Error 11
    GoTo AfterErrTest
MyErrorHandler:
    errCaughtCode = Err
    errCaughtLine = Erl
    errCaughtMsg = Error$
    Resume Next
AfterErrTest:
    On Error GoTo 0
    CheckVal("On Error GoTo / Err / Erl / Resume", "Trapped Error 11 at line " & CStr(errCaughtLine), errCaughtCode & ":" & errCaughtMsg, "11:Division by zero")

    On Error Resume Next
    Err.Raise(9, "TestSource", "Custom subscript error")
    Dim raisedInfo As String
    raisedInfo = Err.Number & ":" & Err.Description
    Err.Clear
    Dim afterClear As Integer : afterClear = Err
    On Error GoTo 0
    CheckVal("On Error Resume Next / Err.Raise", "Custom Err.Raise and Err.Clear", raisedInfo & " (Cleared=" & afterClear & ")", "9:Custom subscript error (Cleared=0)")

    Dim cvErrVar As Variant
    cvErrVar = CVErr(42)
    CheckVal("CVErr(42) & IsError(v)", "Error variant creation and inspection", IsError(cvErrVar) & "/" & IsError(123), "-1/0")

    Rem ========================================================================
    Rem SECTION 3 - CORE MATH, NUMERIC & TYPE CONVERSION FUNCTIONS
    Rem ========================================================================
    LogHeader("CORE MATH, NUMERIC & TYPE CONVERSION FUNCTIONS", _
              "Sin, Cos, Tan, Atn, Exp, Log, Sqr, Abs, Sgn, Int, Fix, Round, Rnd, CInt, CLng, CDbl, CSng, CStr, Val, Str$, Hex$, Oct$.")

    CheckNum("Sin(Pi/2) + Cos(0)", "Trigonometric Sin and Cos", Sin(Pi / 2.0) + Cos(0.0), 2.0, 1e-9)
    CheckNum("Tan(Pi/4) / Atn(1)*4", "Tangent and Arctangent (Atn(1)*4 = Pi)", Tan(Pi / 4.0) + (Atn(1.0) * 4.0), 1.0 + Pi, 1e-9)
    CheckNum("Log(Exp(3.5))", "Natural logarithm Log(x) and exponential Exp(x)", Log(Exp(3.5)), 3.5, 1e-9)
    CheckNum("Sqr(144)", "Square root Sqr(x)", Sqr(144.0), 12.0, 1e-9)
    CheckVal("Abs(-42.5) / Sgn(-9) / Sgn(8)", "Absolute value Abs and Sign Sgn", Abs(-42.5) & "/" & Sgn(-9) & "/" & Sgn(8), "42.5/-1/1")
    CheckVal("Int(-3.7) vs Fix(-3.7)", "Int floors toward -Inf (-4); Fix truncates toward 0 (-3)", Int(-3.7) & " vs " & Fix(-3.7), "-4 vs -3")
    CheckNum("Round(3.14159, 3)", "Decimal rounding Round(val, decimals)", Round(3.14159, 3), 3.142, 1e-9)
    Dim rVal As Double : rVal = Rnd()
    CheckVal("Rnd() in [0, 1]", "Pseudo-random number generator Rnd()", (rVal >= 0.0 And rVal <= 1.0), -1)
    CheckVal("CInt(3.6) / CLng(99.2)", "Integer (CInt) and Long (CLng) coercion", CInt(3.6) & "/" & CLng(99.2), "4/99")
    CheckNum("CDbl(""12.34"") + CSng(""0.66"")", "Double (CDbl) and Single (CSng) coercion", CDbl("12.34") + CSng("0.66"), 13.0, 1e-9)
    CheckVal("CStr(123) / Str$(456) / Val(""78.5px"")", "String/Number conversions CStr, Str$, Val", CStr(123) & "/" & Trim$(Str$(456)) & "/" & Val("78.5"), "123/456/78.5")
    CheckVal("Hex$(255) / Oct$(64)", "Hexadecimal Hex$ and Octal Oct$ conversion", Hex$(255) & "/" & Oct$(64), "FF/100")

    Rem ========================================================================
    Rem SECTION 4 - STRING MANIPULATION & NUMBER FORMATTING FUNCTIONS
    Rem ========================================================================
    LogHeader("STRING MANIPULATION & NUMBER FORMATTING FUNCTIONS", _
              "Len, Left$, Right$, Mid$ (and Mid statement), InStr, InStrRev, Replace, StrReverse, StrComp, UCase$, LCase$, Trim$/LTrim$/RTrim$, LPad/RPad, LSet/RSet, Space$/Spc/String$, Split, Join, Filter, Chr$/Asc, Format$, FormatNumber/Percent/Currency/Scientific.")

    Dim sampleStr As String : sampleStr = "LibreOffice StarBasic"
    CheckVal("Len / Left$ / Right$ / Mid$", "Substring extraction functions", Len(sampleStr) & "/" & Left$(sampleStr, 5) & "/" & Right$(sampleStr, 5) & "/" & Mid$(sampleStr, 13, 4), "21/Libre/Basic/Star")

    Dim modStr As String : modStr = "Hello World!"
    Mid(modStr, 7, 5) = "Basic"
    CheckVal("Mid(var, 7, 5) = ""Basic""", "In-place Mid$ statement mutation", modStr, "Hello Basic!")

    CheckVal("InStr / InStrRev", "Forward and reverse substring search", InStr(1, "abracadabra", "bra") & "/" & InStrRev("abracadabra", "bra"), "2/9")
    CheckVal("Replace(""a-b-c"", ""-"", ""::"")", "Substring replacement", Replace("a-b-c", "-", "::"), "a::b::c")
    CheckVal("StrReverse(""stressed"")", "Reverse characters in string", StrReverse("stressed"), "desserts")
    CheckVal("StrComp(""abc"", ""ABC"", 1)", "Case-insensitive (1) vs binary (0) comparison", StrComp("abc", "ABC", 1) & "/" & StrComp("abc", "ABC", 0), "0/1")
    CheckVal("UCase$ / LCase$", "Uppercase and lowercase conversion", UCase$("AbC") & "/" & LCase$("XyZ"), "ABC/xyz")
    CheckVal("Trim$ / LTrim$ / RTrim$", "Whitespace trimming functions", Trim$("  hi  ") & "|" & LTrim$("  hi") & "|" & RTrim$("hi  "), "hi|hi|hi")
    CheckVal("LPad(""7"", 4, ""0"") / RPad(""A"", 4, ""."")", "Left and right string padding", LPad("7", 4, "0") & "/" & RPad("A", 4, "."), "0007/A...")

    Dim lBox As String : lBox = "      "
    Dim rBox As String : rBox = "      "
    LSet lBox = "XY"
    RSet rBox = "XY"
    CheckVal("LSet / RSet fixed-width alignment", "Left-align and right-align within fixed buffer", "[" & lBox & "]/[" & rBox & "]", "[XY    ]/[    XY]")
    CheckVal("Space$(3) / Spc(2) / String$(4, ""*"")", "Repeating spaces and characters", Len(Space$(3)) & "/" & Len(Spc(2)) & "/" & String$(4, "*"), "3/2/****")
    CheckVal("Chr$(65) / Asc(""A"")", "ASCII character code conversions", Chr$(65) & "/" & Asc("A"), "A/65")

    Dim spArr As Variant
    spArr = Split("beam,truss,column,frame", ",")
    Dim fltArr As Variant
    fltArr = Filter(spArr, "r", True, 1)
    CheckVal("Split / Filter / Join", "Split CSV, Filter items containing 'r', and Join", Join(spArr, "|") & " -> " & Join(fltArr, "+"), "beam|truss|column|frame -> truss+frame")

    CheckVal("Format$(1234.5, ""#,##0.00"")", "Custom format mask with Format$", Format$(1234.5, "#,##0.00"), "1,234.50")
    CheckVal("FormatNumber(-1234.567, 2, -1, -1, -1)", "FormatNumber with parens and grouping", FormatNumber(-1234.567, 2, -1, -1, -1), "(1,234.57)")
    CheckVal("FormatPercent(0.875, 1)", "FormatPercent formatting", FormatPercent(0.875, 1), "87.5%")
    CheckVal("FormatCurrency(9876.5, 2)", "FormatCurrency formatting", FormatCurrency(9876.5, 2), "$9,876.50")
    CheckVal("FormatScientific(12500, 2)", "FormatScientific exponential notation", FormatScientific(12500, 2), "1.25E+04")

    Rem ========================================================================
    Rem SECTION 5 - ARRAYS & LINEAR ALGEBRA ENGINE (linalg.cpp)
    Rem ========================================================================
    LogHeader("ARRAYS & LINEAR ALGEBRA ENGINE (linalg.cpp)", _
              "Array(), LBound, UBound, Dim/ReDim Preserve, Erase, MatMul (2Dx2D & 2Dx1D), MatInv (Gauss-Jordan), MatTranspose, MatEig & MatEigVec (Jacobi symmetric solver).")

    Dim vList As Variant
    vList = Array(10, 20, 30, 40)
    CheckVal("Array(10,20,30,40) LBound/UBound", "1D Variant array literal & bounds", LBound(vList) & " To " & UBound(vList) & " (v(2)=" & vList(2) & ")", "0 To 3 (v(2)=30)")

    Dim dynArr() As Integer
    ReDim dynArr(1 To 3) As Integer
    dynArr(1) = 11 : dynArr(2) = 22 : dynArr(3) = 33
    ReDim Preserve dynArr(1 To 5) As Integer
    dynArr(4) = 44 : dynArr(5) = 55
    CheckVal("ReDim Preserve dynArr(1 To 5)", "Dynamic array resizing preserving existing elements", dynArr(1) & "," & dynArr(3) & "," & dynArr(5), "11,33,55")
    Erase dynArr

    Dim matA(0 To 1, 0 To 1) As Double
    matA(0, 0) = 4.0 : matA(0, 1) = 7.0
    matA(1, 0) = 2.0 : matA(1, 1) = 6.0

    Dim vecX(0 To 1) As Double
    vecX(0) = 3.0 : vecX(1) = 5.0

    Dim matVecProd As Variant
    matVecProd = MatMul(matA, vecX)
    CheckVal("MatMul(A_2x2, x_2x1)", "Matrix-Vector multiplication [4*3+7*5, 2*3+6*5]", matVecProd(0) & "," & matVecProd(1), "47,36")

    Dim matAInv As Variant
    matAInv = MatInv(matA)
    Dim matIdent As Variant
    matIdent = MatMul(matA, matAInv)
    CheckNum("MatInv(A) -> A(0,0)^-1", "Gauss-Jordan inverse of [[4,7],[2,6]] is [[0.6,-0.7],[-0.2,0.4]]", matAInv(0, 0), 0.6, 1e-9)
    CheckNum("MatMul(A, MatInv(A))(0,0)+(1,1)", "Identity check Tr(A * A^-1) = 2.0", matIdent(0, 0) + matIdent(1, 1), 2.0, 1e-9)

    Dim matT As Variant
    matT = MatTranspose(matA)
    CheckVal("MatTranspose(A)", "Transpose swaps off-diagonal (0,1) and (1,0)", matT(0, 1) & "," & matT(1, 0), "2,7")

    Dim symM(0 To 1, 0 To 1) As Double
    symM(0, 0) = 2.0 : symM(0, 1) = 1.0
    symM(1, 0) = 1.0 : symM(1, 1) = 2.0
    Dim eVecs As Variant
    Dim eVals As Variant
    eVals = MatEig(symM, eVecs)
    Dim eVecsDirect As Variant
    eVecsDirect = MatEigVec(symM)
    CheckVal("MatEig([[2,1],[1,2]], eVecs)", "Eigenvalues of [[2,1],[1,2]] sorted ascending (1, 3)", Round(eVals(0), 6) & "," & Round(eVals(1), 6), "1,3")
    CheckNum("MatEigVec orthogonality", "Dot product of eigenvectors v0 . v1 = 0", eVecsDirect(0, 0) * eVecsDirect(0, 1) + eVecsDirect(1, 0) * eVecsDirect(1, 1), 0.0, 1e-9)

    Rem ========================================================================
    Rem SECTION 6 - DATE & TIME FUNCTIONS
    Rem ========================================================================
    LogHeader("DATE & TIME ENGINE", _
              "Date/Date$, Time/Time$, Now, Timer, Year, Month, Day, Hour, Minute, Second, Weekday, DateSerial, TimeSerial, DateValue, TimeValue, DateAdd, DateDiff, DatePart, FormatDateTime.")

    Dim dtSer As Variant : dtSer = DateSerial(2026, 11, 9)
    Dim tmSer As Variant : tmSer = TimeSerial(14, 30, 45)
    CheckVal("DateSerial(2026, 11, 9)", "Construct ISO date from Year, Month, Day", dtSer, "2026-11-09")
    CheckVal("TimeSerial(14, 30, 45)", "Construct time from Hour, Minute, Second", tmSer, "14:30:45")
    CheckVal("DateValue / TimeValue", "Parse date and time strings", DateValue("2026-11-09 14:30:45") & " | " & TimeValue("14:30:45"), "2026-11-09 | 14:30:45")

    Dim fullDT As String : fullDT = "2026-11-09 14:30:45"
    CheckVal("Year / Month / Day", "Extract calendar components", Year(fullDT) & "-" & Month(fullDT) & "-" & Day(fullDT), "2026-11-9")
    CheckVal("Hour / Minute / Second / Weekday", "Extract clock components & day of week", Hour(fullDT) & ":" & Minute(fullDT) & ":" & Second(fullDT) & " (WD=" & Weekday(fullDT) & ")", "14:30:45 (WD=2)")

    CheckVal("DateAdd(""d"", 10, ""2026-11-09"")", "Add 10 days to date", DateAdd("d", 10, "2026-11-09"), "2026-11-19")
    CheckVal("DateDiff(""d"", ""2026-11-01"", ""2026-11-09"")", "Days between two dates", DateDiff("d", "2026-11-01", "2026-11-09"), 8)
    CheckVal("DatePart(""q"", ""2026-11-09"")", "Extract quarter of the year (Q4)", DatePart("q", "2026-11-09"), 4)
    CheckVal("FormatDateTime(dt, 1..4)", "Named date/time formats (Long/Short)", FormatDateTime(fullDT, 2) & " | " & FormatDateTime(fullDT, 4), "2026-11-09 | 14:30")

    Dim oldDate As String : oldDate = Date$
    Date = "2030-01-15"
    Dim simDate As String : simDate = Date$
    Date = oldDate
    CheckVal("Date / Time / Now / Timer", "System clock access & simulated Date assignment", simDate & " (Timer>0=" & (Timer >= 0) & ", Len(Now)=" & (Len(Now) >= 10) & ")", "2030-01-15 (Timer>0=-1, Len(Now)=-1)")

    Rem ========================================================================
    Rem SECTION 7 - LIBREOFFICE CALC SPREADSHEET FUNCTIONS (calc.*)
    Rem ========================================================================
    LogHeader("LIBREOFFICE CALC SPREADSHEET FUNCTIONS (calc.*)", _
              "Hyperbolic, Trigonometric, Combinatorics, Rounding, Array Math (SUM, SUMPRODUCT, SUMX2MY2, SUMIF/S), Lookup (VLOOKUP, HLOOKUP, LOOKUP, XLOOKUP, MATCH, INDEX, CHOOSE), Database (DGET, DSUM, DAVERAGE, DCOUNT, etc.), Statistics, Text & Logical.")

    CheckNum("calc.SINH(0) + calc.COSH(0)", "Hyperbolic sine & cosine at 0", calc.SINH(0.0) + calc.COSH(0.0), 1.0, 1e-9)
    CheckNum("calc.TANH(1) * calc.COTH(1)", "Hyperbolic tangent * cotangent = 1", calc.TANH(1.0) * calc.COTH(1.0), 1.0, 1e-9)
    CheckNum("calc.SECH(0) + calc.CSCH(1)*calc.SINH(1)", "Hyperbolic secant & cosecant", calc.SECH(0.0) + calc.CSCH(1.0) * calc.SINH(1.0), 2.0, 1e-9)
    CheckNum("calc.ASINH(calc.SINH(1.2))", "Inverse hyperbolic sine", calc.ASINH(calc.SINH(1.2)), 1.2, 1e-9)
    CheckNum("calc.ACOSH(calc.COSH(1.5))", "Inverse hyperbolic cosine", calc.ACOSH(calc.COSH(1.5)), 1.5, 1e-9)
    CheckNum("calc.ATANH(0.5) + calc.ACOTH(2.0)", "Inverse hyperbolic tangent & cotangent", calc.ATANH(0.5) - calc.ACOTH(2.0), 0.0, 1e-9)
    CheckNum("calc.ASECH(0.5) / calc.ACSCH(1.0)", "Inverse hyperbolic secant & cosecant", calc.ASECH(1.0) + calc.ACSCH(calc.CSCH(1.0)), 1.0, 1e-9)

    CheckNum("calc.DEGREES(calc.RADIANS(180))", "Degrees <-> Radians conversion", calc.DEGREES(calc.RADIANS(180.0)), 180.0, 1e-9)
    CheckNum("calc.ASIN(0.5) + calc.ACOS(0.5)", "asin(0.5) + acos(0.5) = Pi/2", calc.ASIN(0.5) + calc.ACOS(0.5), calc.PI() / 2.0, 1e-9)
    CheckNum("calc.ATAN2(1, 1) / calc.COT(Pi/4)", "Calc ATAN2(x,y) and COT(x)", calc.ATAN2(1.0, 1.0) + calc.COT(calc.PI() / 4.0) + calc.ACOT(1.0), 1.0 + calc.PI() / 2.0, 1e-9)
    CheckNum("calc.LN(Exp(2)) + calc.LOG10(100) + calc.LOG(8,2)", "Logarithms LN, LOG10, LOG(n, base)", calc.LN(Exp(2.0)) + calc.LOG10(100.0) + calc.LOG(8.0, 2.0), 7.0, 1e-9)
    CheckNum("calc.POWER(3,4) + calc.SQRT(25) + calc.SQRTPI(Pi)", "POWER, SQRT, and SQRTPI", calc.POWER(3, 4) + calc.SQRT(25) + calc.SQRTPI(calc.PI()), 86.0 + calc.PI(), 1e-9)
    CheckVal("calc.FACT(5) / calc.FACTDOUBLE(6)", "Factorial (5!=120) and Double Factorial (6!!=48)", calc.FACT(5) & "/" & calc.FACTDOUBLE(6), "120/48")
    CheckVal("calc.COMBIN(5,2) / calc.COMBINA(3,2) / calc.PERMUT(5,2)", "Combinatorics COMBIN, COMBINA, PERMUT", calc.COMBIN(5, 2) & "/" & calc.COMBINA(3, 2) & "/" & calc.PERMUT(5, 2), "10/6/20")
    CheckVal("calc.GCD(24, 36, 60) / calc.LCM(4, 6, 8)", "Greatest Common Divisor & Least Common Multiple", calc.GCD(24, 36, 60) & "/" & calc.LCM(4, 6, 8), "12/24")
    CheckVal("calc.ROUND / ROUNDUP / ROUNDDOWN / TRUNC", "Calc rounding family on 2.345", calc.ROUND(2.345, 2) & "/" & calc.ROUNDUP(2.341, 2) & "/" & calc.ROUNDDOWN(2.349, 2) & "/" & calc.TRUNC(2.99, 1), "2.35/2.35/2.34/2.9")
    CheckVal("calc.MROUND / CEILING / FLOOR / EVEN / ODD", "Multiple & parity rounding functions", calc.MROUND(13, 5) & "/" & calc.CEILING(4.2, 1) & "/" & calc.FLOOR(4.8, 1) & "/" & calc.EVEN(3) & "/" & calc.ODD(4), "15/5/4/4/5")
    CheckVal("calc.MOD(17, 5) / calc.QUOTIENT(17, 5) / calc.SIGN(-8)", "Calc MOD, QUOTIENT, SIGN, RANDBETWEEN", calc.MOD(17, 5) & "/" & calc.QUOTIENT(17, 5) & "/" & calc.SIGN(-8) & "/" & calc.RANDBETWEEN(5, 5), "2/3/-1/5")

    Dim arrX As Variant : arrX = Array(1, 2, 3, 4)
    Dim arrY As Variant : arrY = Array(2, 3, 4, 5)
    CheckVal("calc.SUM / PRODUCT / SUMSQ / SUMPRODUCT", "Array aggregations on [1,2,3,4] and [2,3,4,5]", calc.SUM(arrX) & "/" & calc.PRODUCT(arrX) & "/" & calc.SUMSQ(arrX) & "/" & calc.SUMPRODUCT(arrX, arrY), "10/24/30/40")
    CheckVal("calc.SUMX2MY2 / SUMX2PY2 / SUMXMY2", "Sum of squares differences/sums", calc.SUMX2MY2(arrY, arrX) & "/" & calc.SUMX2PY2(arrX, arrY) & "/" & calc.SUMXMY2(arrX, arrY), "24/84/4")

    Dim catArr As Variant : catArr = Array("Steel", "Wood", "Steel", "Concrete", "Steel")
    Dim costArr As Variant : costArr = Array(100, 50, 200, 150, 300)
    CheckVal("calc.SUMIF / COUNTIF / AVERAGEIF", "Single-criteria conditional aggregations", calc.SUMIF(catArr, "Steel", costArr) & "/" & calc.COUNTIF(catArr, "Steel") & "/" & calc.AVERAGEIF(catArr, "Steel", costArr), "600/3/200")
    CheckVal("calc.SUMIFS / COUNTIFS / AVERAGEIFS / MAXIFS / MINIFS", "Multi-criteria conditional aggregations", calc.SUMIFS(costArr, catArr, "Steel", costArr, ">150") & "/" & calc.COUNTIFS(catArr, "Steel", costArr, ">=200") & "/" & calc.AVERAGEIFS(costArr, catArr, "Steel", costArr, ">=200") & "/" & calc.MAXIFS(costArr, catArr, "Steel") & "/" & calc.MINIFS(costArr, catArr, "Steel"), "500/2/250/300/100")

    Dim statArr As Variant : statArr = Array(10, 20, 20, 30, 40)
    CheckVal("calc.AVERAGE / MEDIAN / MODE / MAX / MIN", "Central tendency and extrema", calc.AVERAGE(statArr) & "/" & calc.MEDIAN(statArr) & "/" & calc.MODE(statArr) & "/" & calc.MAX(statArr) & "/" & calc.MIN(statArr), "24/20/20/40/10")
    CheckVal("calc.COUNT / COUNTA / COUNTBLANK", "Cell counting functions", calc.COUNT(statArr) & "/" & calc.COUNTA(catArr) & "/" & calc.COUNTBLANK(Array("A", "", "B")), "5/5/1")
    CheckVal("calc.LARGE / SMALL / PERCENTILE / QUARTILE / RANK", "Order statistics & ranking", calc.LARGE(statArr, 2) & "/" & calc.SMALL(statArr, 2) & "/" & calc.PERCENTILE(statArr, 0.5) & "/" & calc.QUARTILE(statArr, 2) & "/" & calc.RANK(30, statArr), "30/20/20/20/2")
    CheckNum("calc.VAR / VARP / STDEV / STDEVP / DEVSQ / AVEDEV", "Variance and standard deviation", calc.VAR(statArr) + calc.VARP(statArr) + calc.DEVSQ(statArr) + calc.AVEDEV(statArr) + Round(calc.STDEV(statArr), 4) + Round(calc.STDEVP(statArr), 4), 130.0 + 104.0 + 520.0 + 8.8 + 11.4018 + 10.198, 1e-3)
    CheckNum("calc.GEOMEAN(4, 9) + calc.HARMEAN(3, 6)", "Geometric mean (6) + Harmonic mean (4)", calc.GEOMEAN(4, 9) + calc.HARMEAN(3, 6), 10.0, 1e-9)
    CheckNum("calc.SLOPE / INTERCEPT / CORREL / RSQ / FORECAST", "Linear regression on Y=2*X+1", calc.SLOPE(arrY, arrX) + calc.INTERCEPT(arrY, arrX) + calc.CORREL(arrY, arrX) + calc.RSQ(arrY, arrX) + calc.FORECAST(10, arrY, arrX) + calc.COVAR(arrY, arrX), 1.0 + 1.0 + 1.0 + 1.0 + 11.0 + 1.25, 1e-9)

    Dim lkpTable(0 To 2, 0 To 2) As Variant
    lkpTable(0, 0) = "B10" : lkpTable(0, 1) = "Bolt M10" : lkpTable(0, 2) = 12.5
    lkpTable(1, 0) = "B12" : lkpTable(1, 1) = "Bolt M12" : lkpTable(1, 2) = 18.0
    lkpTable(2, 0) = "B16" : lkpTable(2, 1) = "Bolt M16" : lkpTable(2, 2) = 29.5
    CheckVal("calc.VLOOKUP / INDEX / MATCH / ROWS / COLUMNS", "Table lookup & indexing", calc.VLOOKUP("B12", lkpTable, 2, 0) & " | " & calc.INDEX(lkpTable, 3, 3) & " | M=" & calc.MATCH("B16", Array("B10", "B12", "B16"), 0) & " (" & calc.ROWS(lkpTable) & "x" & calc.COLUMNS(lkpTable) & ")", "Bolt M12 | 29.5 | M=3 (3x3)")

    Dim hTable(0 To 1, 0 To 2) As Variant
    hTable(0, 0) = "Q1" : hTable(0, 1) = "Q2" : hTable(0, 2) = "Q3"
    hTable(1, 0) = 100  : hTable(1, 1) = 250  : hTable(1, 2) = 400
    CheckVal("calc.HLOOKUP / LOOKUP / XLOOKUP / CHOOSE", "Horizontal, vector, and XLOOKUP", calc.HLOOKUP("Q2", hTable, 2, 0) & "/" & calc.LOOKUP(2, Array(1, 2, 3), Array("One", "Two", "Three")) & "/" & calc.XLOOKUP("B16", Array("B10", "B12", "B16"), Array(12.5, 18.0, 29.5)) & "/" & calc.CHOOSE(2, "Alpha", "Beta", "Gamma"), "250/Two/29.5/Beta")

    Dim dbTable(0 To 4, 0 To 2) As Variant
    dbTable(0, 0) = "Part"  : dbTable(0, 1) = "Grade" : dbTable(0, 2) = "Load"
    dbTable(1, 0) = "Beam"  : dbTable(1, 1) = "A36"   : dbTable(1, 2) = 120
    dbTable(2, 0) = "Truss" : dbTable(2, 1) = "A992"  : dbTable(2, 2) = 200
    dbTable(3, 0) = "Beam"  : dbTable(3, 1) = "A992"  : dbTable(3, 2) = 180
    dbTable(4, 0) = "Col"   : dbTable(4, 1) = "A992"  : dbTable(4, 2) = 300

    Dim dbCrit(0 To 1, 0 To 1) As Variant
    dbCrit(0, 0) = "Part" : dbCrit(0, 1) = "Grade"
    dbCrit(1, 0) = "Beam" : dbCrit(1, 1) = "A992"
    Dim dbCritGrade(0 To 1, 0 To 0) As Variant
    dbCritGrade(0, 0) = "Grade"
    dbCritGrade(1, 0) = "A992"

    CheckVal("calc.DGET / DSUM / DAVERAGE / DCOUNT / DCOUNTA", "Database functions on 2D criteria range", calc.DGET(dbTable, "Load", dbCrit) & "/" & calc.DSUM(dbTable, "Load", dbCritGrade) & "/" & calc.DAVERAGE(dbTable, "Load", dbCritGrade) & "/" & calc.DCOUNT(dbTable, "Load", dbCritGrade) & "/" & calc.DCOUNTA(dbTable, "Part", dbCritGrade), "180/680/226.666666667/3/3")
    CheckVal("calc.DMAX / DMIN / DPRODUCT / DVARP / DSTDEVP", "Database extrema, product & variance", calc.DMAX(dbTable, "Load", dbCritGrade) & "/" & calc.DMIN(dbTable, "Load", dbCritGrade) & "/" & calc.DPRODUCT(dbTable, "Load", dbCrit) & "/" & Round(calc.DVARP(dbTable, "Load", dbCritGrade), 2) & "/" & Round(calc.DSTDEVP(dbTable, "Load", dbCritGrade), 2), "300/180/180/2755.56/52.49")

    CheckVal("calc.CONCAT / TEXTJOIN / PROPER / REPT", "Calc text functions", calc.CONCAT("FE", "A") & "|" & calc.TEXTJOIN("-", 1, "A", "", "B", "C") & "|" & calc.PROPER("hello world") & "|" & calc.REPT("*", 3), "FEA|A-B-C|Hello World|***")
    CheckVal("calc.EXACT / FIND / SEARCH / SUBSTITUTE / REPLACE", "Calc string search & replace", calc.EXACT("A", "A") & "/" & calc.FIND("B", "aBc") & "/" & calc.SEARCH("b", "aBc") & "/" & calc.SUBSTITUTE("a-b-a", "a", "X", 2) & "/" & calc.REPLACE("abcdef", 3, 2, "XY"), "-1/2/2/a-b-X/abXYef")
    CheckVal("calc.VALUE / TEXT / CLEAN", "Calc value parsing and text formatting", calc.VALUE("42.5") & "/" & calc.TEXT(12.3, "0.00") & "/" & calc.CLEAN("Hi" & Chr$(7)), "42.5/12.30/Hi")
    CheckVal("calc.IF / IFS / SWITCH / AND / OR / XOR / NOT", "Calc logical & branching functions", calc.IF(1, "Y", "N") & "/" & calc.IFS(0, "A", 1, "B") & "/" & calc.SWITCH(2, 1, "One", 2, "Two") & "/" & calc.AND(1, 1) & "/" & calc.OR(0, 1) & "/" & calc.XOR(1, 1) & "/" & calc.NOT(0), "Y/B/Two/-1/-1/0/-1")
    CheckVal("calc.IFERROR / IFNA / ISNUMBER / ISTEXT / ISEVEN / ISODD", "Calc error-handling and information functions", calc.IFERROR(CVErr(11), "Recov") & "/" & calc.IFNA(CVErr(42), "NA_OK") & "/" & calc.ISNUMBER(42) & "/" & calc.ISTEXT("hi") & "/" & calc.ISEVEN(4) & "/" & calc.ISODD(5), "Recov/NA_OK/-1/-1/-1/-1")

    Rem ========================================================================
    Rem SECTION 8 - FILE SYSTEM, DIRECTORY & SEQUENTIAL/BINARY/RANDOM FILE I/O
    Rem ========================================================================
    LogHeader("FILE SYSTEM, DIRECTORY & SEQUENTIAL/BINARY/RANDOM I/O", _
              "MkDir, ChDir, CurDir$, Open (Output, Append, Input, Binary, Random), Print #, Write #, Line Input #, Input #, Input$, Seek, Loc, LOF, EOF, Put #, Get #, Lock/Unlock, FileCopy, Name As, FileLen, FileDateTime, GetAttr, SetAttr, Dir$, Kill, RmDir.")

    Dim startDir As String : startDir = CurDir$()
    Dim tempDir As String : tempDir = "_sbasic_tmp_test_dir"
    Dim seqFile1 As String : seqFile1 = "_tmp_seq1.txt"
    Dim seqFile2 As String : seqFile2 = "_tmp_seq2.txt"
    Dim binFile As String : binFile = "_tmp_bin.dat"
    Dim rndFile As String : rndFile = "_tmp_rnd.dat"

    MkDir tempDir
    Dim dirFound As String : dirFound = Dir$(tempDir, 16)
    CheckVal("MkDir & Dir$(path, 16)", "Create directory and verify with Dir$", dirFound, tempDir)

    ChDir tempDir
    Dim insideDir As Boolean : insideDir = (InStr(1, CurDir$(), tempDir) > 0)
    ChDir startDir
    CheckVal("ChDir & CurDir$()", "Change working directory and restore", insideDir, -1)

    Dim chSeq As Integer : chSeq = FreeFile
    Open seqFile1 For Output As #chSeq
    Print #chSeq, "LineOne"; Tab(12); "Col12"
    Write #chSeq, "CSV_Text", 123, 45.5
    Close #chSeq

    chSeq = FreeFile
    Open seqFile1 For Append As #chSeq
    Print #chSeq, "AppendedLine"
    Close #chSeq

    Dim ln1 As String, wStr As String, wInt As Integer, wFlt As Double, ln3 As String
    chSeq = FreeFile
    Open seqFile1 For Input As #chSeq
    Dim fileTotalLen As Integer : fileTotalLen = LOF(chSeq)
    Line Input #chSeq, ln1
    Input #chSeq, wStr, wInt, wFlt
    Line Input #chSeq, ln3
    Dim atEof As Integer : atEof = EOF(chSeq)
    Seek #chSeq, 1
    Dim firstFour As String : firstFour = Input$(4, #chSeq)
    Dim curSeekPos As Integer : curSeekPos = Seek(chSeq)
    Dim curLocPos As Integer : curLocPos = Loc(chSeq)
    Close #chSeq

    CheckVal("Open Output/Append/Input, Line Input#", "Read formatted Print#/Tab and appended line", Trim$(ln1) & " | " & ln3 & " (EOF=" & atEof & ")", "LineOne    Col12 | AppendedLine (EOF=-1)")
    CheckVal("Write # & Input #ch, v1, v2, v3", "Structured CSV Write# and Input# parsing", wStr & "/" & wInt & "/" & wFlt, "CSV_Text/123/45.5")
    CheckVal("LOF / Seek / Loc / Input$(4, #ch)", "Stream length, Seek(1), Input$(4), Seek/Loc", (fileTotalLen > 20) & "/" & firstFour & "/Seek=" & curSeekPos & "/Loc=" & curLocPos, "-1/Line/Seek=5/Loc=4")

    Dim chBin As Integer : chBin = FreeFile
    Open binFile For Binary As #chBin
    Lock #chBin
    Dim putInt As Integer : putInt = 987654
    Dim putDbl As Double : putDbl = 3.1415926
    Put #chBin, 1, putInt
    Put #chBin, 9, putDbl
    Dim readInt As Integer : readInt = 0
    Dim readDbl As Double : readDbl = 0.0
    Get #chBin, 1, readInt
    Get #chBin, 9, readDbl
    Unlock #chBin
    Close #chBin
    CheckVal("Open Binary, Lock/Unlock, Put#, Get#", "Binary record I/O at explicit byte offsets", readInt & " / " & Round(readDbl, 5), "987654 / 3.14159")

    Dim chRnd As Integer : chRnd = FreeFile
    Open rndFile For Random As #chRnd Len = 64
    Dim rec1 As String : rec1 = "Record_One"
    Dim rec2 As String : rec2 = "Record_Two"
    Put #chRnd, 1, rec1
    Put #chRnd, 2, rec2
    Dim gotRec1 As String, gotRec2 As String
    Get #chRnd, 2, gotRec2
    Get #chRnd, 1, gotRec1
    Close #chRnd
    CheckVal("Open Random Len=64, Put#, Get#", "Random-access record I/O by record number", gotRec1 & " & " & gotRec2, "Record_One & Record_Two")

    FileCopy seqFile1, seqFile2
    Dim renamedFile As String : renamedFile = "_tmp_seq_renamed.txt"
    Name seqFile2 As renamedFile
    Dim fLen As Integer : fLen = FileLen(renamedFile)
    Dim fDt As String : fDt = FileDateTime(renamedFile)
    SetAttr renamedFile, 0
    Dim fAttr As Integer : fAttr = GetAttr(renamedFile)
    CheckVal("FileCopy, Name As, FileLen, FileDateTime, GetAttr", "File metadata & copy/rename operations", (fLen > 0) & " / Len(DT)=" & (Len(fDt) >= 10) & " / Attr=" & fAttr, "-1 / Len(DT)=-1 / Attr=0")

    Rem ========================================================================
    Rem SECTION 9 - NATIVE SPREADSHEET ENGINE (.ODS / .XLSX / .CSV)
    Rem ========================================================================
    LogHeader("NATIVE SPREADSHEET ENGINE (.ODS / .XLSX / .CSV - liboffice.cpp)", _
              "ODS.New, Sheets.getCount/hasByName/getByName/getByIndex/getName/insertNewByName/copyByName/removeByName, getCellByPosition/Name, getCellRangeByPosition/Name, setValue/getValue, setString/getString, setDataArray/getDataArray, SearchString/SearchNext, getCellAddress, ODS.SaveAs & ODS.Open (.ods, .xlsx, .csv).")

    Dim tmpOds As String : tmpOds = "_tmp_test_book.ods"
    Dim tmpXlsx As String : tmpXlsx = "_tmp_test_book.xlsx"
    Dim tmpCsv As String : tmpCsv = "_tmp_test_book.csv"

    ODS.New
    Sheets.insertNewByName("DataSheet", 1)
    Sheets.copyByName("Sheet1", "BackupSheet")
    Dim shCountBefore As Integer : shCountBefore = Sheets.getCount()
    Sheets.removeByName("BackupSheet")
    Dim shCountAfter As Integer : shCountAfter = Sheets.getCount()
    CheckVal("ODS.New / Sheets.insert / copy / remove", "Workbook sheet management", shCountBefore & " -> " & shCountAfter & " (HasData=" & Sheets.hasByName("DataSheet") & ")", "3 -> 2 (HasData=-1)")

    Sheets.getByName("DataSheet")
    Sheet.getCellByName("A1")
    setString("Component")
    Sheet.getCellByPosition(1, 0)
    setString("Force_kN")
    setCellValue(0, 1, "Beam_B1")
    setCellValue(1, 1, 125.5)
    setCellValue(0, 2, "Beam_B2")
    setCellValue(1, 2, 250.75)

    Dim blk(0 To 1, 0 To 1) As Variant
    blk(0, 0) = "Col_C1" : blk(0, 1) = 400.0
    blk(1, 0) = "Col_C2" : blk(1, 1) = 550.25
    Sheet.getCellRangeByName("A4:B5")
    setDataArray(blk)

    Dim sFound1 As Integer : sFound1 = SearchString("Beam")
    Dim addr1 As String : addr1 = getCellAddressString()
    Dim sFound2 As Integer : sFound2 = SearchNext("Beam")
    Dim addr2 As String : addr2 = getCellAddressString()
    CheckVal("SearchString / SearchNext / getCellAddress", "Locate cells matching 'Beam' across sheet", sFound1 & ":" & addr1 & " -> " & sFound2 & ":" & addr2, "-1:$DataSheet.$A$2 -> -1:$DataSheet.$A$3")

    ODS.SaveAs(tmpOds)
    ODS.SaveAs(tmpXlsx)
    ODS.SaveAs(tmpCsv)

    ODS.New
    ODS.Open(tmpOds)
    Sheets.getByName("DataSheet")
    Sheet.getCellRangeByPosition(0, 0, 1, 4)
    Dim odsData As Variant : odsData = getDataArray()
    CheckVal("ODS.SaveAs & ODS.Open (.ods)", "Round-trip .ods ZIP archive verification", odsData(0, 0) & ":" & odsData(1, 1) & ":" & odsData(4, 0) & "=" & odsData(4, 1), "Component:125.5:Col_C2=550.25")

    ODS.New
    ODS.Open(tmpXlsx)
    Sheets.getByName("DataSheet")
    CheckVal("ODS.SaveAs & ODS.Open (.xlsx)", "Round-trip .xlsx OpenXML ZIP verification", getCellValue(0, 2) & "=" & getCellValue(1, 2) & ", " & getCellValue(0, 4) & "=" & getCellValue(1, 4), "Beam_B2=250.75, Col_C2=550.25")

    ODS.New
    ODS.Open(tmpCsv)
    CheckVal("ODS.SaveAs & ODS.Open (.csv)", "Round-trip .csv text table verification", getCellValue(0, 1) & "=" & getCellValue(1, 1), "Beam_B1=125.5")

    Sheet.getCellRangeByName("A4:B5")
    Sheet.clearContents()
    CheckVal("Sheet.clearContents()", "Cleared cell range A4:B5 returns 0/empty", getCellValue(1, 3) & "/" & getString(), "0/")

    Rem ========================================================================
    Rem SECTION 10 - NATIVE DOCUMENT ENGINE (.ODT / .DOCX / .TXT)
    Rem ========================================================================
    LogHeader("NATIVE DOCUMENT ENGINE (.ODT / .DOCX / .TXT - liboffice.cpp)", _
              "DOC.New, DOC.AppendHeading, DOC.AppendParagraph, DOC.InsertParagraph, DOC.RemoveParagraph, DOC.GetParagraphCount, DOC.GetParagraph/SetParagraph, DOC.GetHeadingLevel/SetHeadingLevel, DOC.GetParagraphStyle/SetParagraphStyle, DOC.SearchText/SearchNext, DOC.ReplaceAll, DOC.SaveAs & DOC.Open (.odt, .docx, .txt).")

    Dim tmpOdt As String : tmpOdt = "_tmp_test_doc.odt"
    Dim tmpDocx As String : tmpDocx = "_tmp_test_doc.docx"
    Dim tmpTxt As String : tmpTxt = "_tmp_test_doc.txt"

    DOC.New
    DOC.AppendParagraph("Structural Calculation Report", "Title")
    DOC.AppendHeading("1. Executive Summary", 1)
    DOC.AppendParagraph("All steel members satisfy AISC 360 ASD provisions.")
    DOC.AppendParagraph("Deflection < L/360", "Quotations")
    DOC.InsertParagraph(2, "Inserted Section 1.1", 2)
    DOC.RemoveParagraph(2)
    DOC.SetParagraphStyle(2, "Preformatted Text")

    Dim pCnt As Integer : pCnt = DOC.GetParagraphCount()
    Dim hLvl As Integer : hLvl = DOC.GetHeadingLevel(1)
    Dim pSty As String : pSty = DOC.GetParagraphStyle(0)
    CheckVal("DOC.AppendHeading / Paragraph / Styles", "Document structure & paragraph styles", "Count=" & pCnt & ", H1=" & hLvl & ", Style0=" & pSty, "Count=4, H1=1, Style0=Title")

    Dim dSearch1 As Integer : dSearch1 = DOC.SearchText("steel")
    Dim repCnt As Integer : repCnt = DOC.ReplaceAll("ASD", "LRFD & ASD")
    CheckVal("DOC.SearchText & DOC.ReplaceAll", "Search paragraph index and replace substring", "FoundAt=" & dSearch1 & ", Replaced=" & repCnt, "FoundAt=2, Replaced=1")

    DOC.SaveAs(tmpOdt)
    DOC.SaveAs(tmpDocx)
    DOC.SaveAs(tmpTxt)

    DOC.New
    DOC.Open(tmpOdt)
    CheckVal("DOC.SaveAs & DOC.Open (.odt)", "Round-trip .odt ODF ZIP document & styles", DOC.GetParagraphStyle(0) & " | H" & DOC.GetHeadingLevel(1) & " | " & DOC.GetParagraph(2), "Title | H1 | All steel members satisfy AISC 360 LRFD & ASD provisions.")

    DOC.New
    DOC.Open(tmpDocx)
    CheckVal("DOC.SaveAs & DOC.Open (.docx)", "Round-trip .docx Word OpenXML ZIP document", DOC.GetParagraphStyle(0) & " | H" & DOC.GetHeadingLevel(1) & " | " & DOC.GetParagraph(3), "Title | H1 | Deflection < L/360")

    DOC.New
    DOC.Open(tmpTxt)
    CheckVal("DOC.SaveAs & DOC.Open (.txt)", "Round-trip plain text document", DOC.GetParagraphCount() & " lines (" & DOC.GetParagraph(0) & ")", "4 lines (Structural Calculation Report)")

    Rem ========================================================================
    Rem SECTION 11 - CLEANUP OF ALL TEMPORARY TEST FILES & FINAL SUMMARY
    Rem ========================================================================
    LogHeader("CLEANUP OF ALL TEMPORARY TEST FILES & FINAL VALIDATION SUMMARY", _
              "Deletes all temporary files and directories created during testing (Kill, RmDir) and verifies clean state before closing validation.txt.")

    Kill seqFile1
    Kill renamedFile
    Kill binFile
    Kill rndFile
    Kill tmpOds
    Kill tmpXlsx
    Kill tmpCsv
    Kill tmpOdt
    Kill tmpDocx
    Kill tmpTxt
    RmDir tempDir

    Dim remainingTmp As String
    remainingTmp = Dir$("_tmp_*")
    Dim remainingDir As String
    remainingDir = Dir$(tempDir, 16)
    CheckVal("Kill _tmp_* & RmDir " & tempDir, "Verify all temporary test files/dirs are deleted", "[" & remainingTmp & "]/[" & remainingDir & "]", "[]/[]")

    LogLine("")
    LogLine("================================================================================")
    LogLine("VALIDATION COMPLETE: " & CStr(gPassCount) & " / " & CStr(gTotalCount) & " TESTS PASSED across " & CStr(gSectionCount) & " sections.")
    LogLine("All temporary files have been deleted. Full guide saved to: validation.txt")
    LogLine("================================================================================")

    Close #gLogCh
    gLogCh = 0
End Sub
