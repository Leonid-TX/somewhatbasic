' ============================================================================
' testsolvers.bas - Verification & Syntax Guide Suite for sBasic Solvers
' Tests LinearSolver(), NonlinearSolver(), and auto-detecting Solver()
' Generates a comprehensive reference & verification report: VerifSolvers.txt
' ============================================================================

Dim passCount As Integer
Dim totalCount As Integer
passCount = 0
totalCount = 0

Dim ch As Integer
ch = FreeFile
Open "VerifSolvers.txt" For Output As #ch

Sub LogLine(txt As String)
    Print txt
    Print #ch, txt
End Sub

Sub RecordTask(taskNum As Integer, title As String, probDesc As String, _
               syntaxShown As String, expectedStr As String, actualStr As String, _
               isOk As Integer)
    totalCount = totalCount + 1
    Dim badge As String
    If isOk Then
        passCount = passCount + 1
        badge = "PASS"
    Else
        badge = "FAIL"
    End If

    LogLine "----------------------------------------------------------------------------"
    LogLine "TASK #" & CStr(taskNum) & ": " & title & "  [" & badge & "]"
    LogLine "----------------------------------------------------------------------------"
    LogLine "  Problem  : " & probDesc
    LogLine "  Syntax   : " & syntaxShown
    LogLine "  Goal/Ref : " & expectedStr
    LogLine "  Solution : " & actualStr
    LogLine "  Status   : " & badge & " (Solver.Status=" & SOLVER.STATUS & _
            ", Time=" & FormatNumber(SOLVER.TIME * 1000, 2) & " ms)"
    LogLine ""
End Sub

Function ObjFunc6() As Double
    ObjFunc6 = 6 * p6 + 4 * q6
End Function

LogLine "============================================================================"
LogLine "  SBASIC LINEAR & NONLINEAR SOLVER - VERIFICATION & SYNTAX GUIDE"
LogLine "  Generated by: testsolvers.bas"
LogLine "============================================================================"
LogLine ""
LogLine "QUICK SYNTAX REFERENCE:"
LogLine "  LinearSolver(""GetMax|GetMin|GetValue=val, By Changing=v1,v2,..., LimitingConditions=c1,c2,..., Options..."")"
LogLine "  NonlinearSolver(""GetMax|GetMin|GetValue=val, By Changing=v1,v2,..., LimitingConditions=c1,c2,..., Options..."")"
LogLine "  Solver(""..."")  ' Auto-detects Linear vs. Nonlinear model"
LogLine ""
LogLine "  Supported Objective & Condition Styles:"
LogLine "    1. Spreadsheet-style Basic variables : GetMax = 3*a + 5*b  :  d = 2*a + 3*b <= 8"
LogLine "    2. Inline mathematical expressions   : GetMin = 4*x + 6*y, Constraints = x + y = 10"
LogLine "    3. User-defined Basic Functions      : Target = MyFunc"
LogLine "    4. String variables & 1D arrays      : d = ""2*a + 3*b <= 8"" or 1D array of strings"
LogLine "    5. Variable domains & bounds         : a = int, b = bin, 0 <= x <= 10, w[1, 20], NonNegative, AllInteger, AllBinary"
LogLine ""

' ============================================================================
' TASK 1: Classic 3-Variable LP Maximization (Spreadsheet-Style Variable Formulas)
' ============================================================================
a = 0 : b = 0 : c = 0
GetMax = 3*a + 5*b + 4*c
d      = 2*a + 3*b <= 8
var    = 2*b + 5*c <= 10
shmar  = 3*a + 2*b + 4*c <= 15

ans1 = LinearSolver("GetMax, By Changing=a,b,c, LimitingConditions = d, var, shmar, TimeLimit=5 min, NonNegative")
ok1 = (Abs(ans1 - 765/41) < 1e-4) And (Abs(a - 89/41) < 1e-4) And (Abs(b - 50/41) < 1e-4) And (Abs(c - 62/41) < 1e-4)
RecordTask 1, "Linear Programming (LP) with Spreadsheet-Style Variable Formulas", _
    "Maximize GetMax = 3a + 5b + 4c s.t. d:(2a+3b<=8), var:(2b+5c<=10), shmar:(3a+2b+4c<=15), a,b,c >= 0", _
    "LinearSolver(""GetMax, By Changing=a,b,c, LimitingConditions = d, var, shmar, TimeLimit=5 min, NonNegative"")", _
    "GetMax = 18.6585 (765/41) at a = 2.1707 (89/41), b = 1.2195 (50/41), c = 1.5122 (62/41)", _
    "GetMax = " & FormatNumber(ans1, 4) & " at a = " & FormatNumber(a, 4) & ", b = " & FormatNumber(b, 4) & ", c = " & FormatNumber(c, 4), _
    ok1

' ============================================================================
' TASK 2: LP Minimization with Inline Expressions & Equality Constraint
' ============================================================================
x2 = 0 : y2 = 0
ans2 = LinearSolver("GetMin = 4*x2 + 6*y2, By Changing = x2, y2, Constraints = x2 + y2 = 10, 2*x2 + y2 >= 14, x2 <= 8, NonNegative")
ok2 = (Abs(ans2 - 44) < 1e-6) And (Abs(x2 - 8) < 1e-6) And (Abs(y2 - 2) < 1e-6)
RecordTask 2, "LP Minimization with Inline Expressions & Equality (=) Constraint", _
    "Minimize 4*x2 + 6*y2 s.t. x2 + y2 = 10, 2*x2 + y2 >= 14, x2 <= 8, x2,y2 >= 0", _
    "LinearSolver(""GetMin = 4*x2 + 6*y2, By Changing = x2, y2, Constraints = x2 + y2 = 10, 2*x2 + y2 >= 14, x2 <= 8, NonNegative"")", _
    "Min = 44.0000 at x2 = 8.0000, y2 = 2.0000", _
    "Min = " & FormatNumber(ans2, 4) & " at x2 = " & FormatNumber(x2, 4) & ", y2 = " & FormatNumber(y2, 4), _
    ok2

' ============================================================================
' TASK 3: Mixed-Integer Linear Programming (MILP) via Branch-and-Bound
' ============================================================================
u3 = 0 : v3 = 0
ans3 = LinearSolver("GetMax = 5*u3 + 8*v3, By Changing = u3, v3, LimitingConditions = u3 + v3 <= 6, 5*u3 + 9*v3 <= 45, u3 = int, v3 = int, NonNegative")
ok3 = (Abs(ans3 - 40) < 1e-6) And (Abs(u3 - 0) < 1e-6) And (Abs(v3 - 5) < 1e-6)
RecordTask 3, "Mixed-Integer Linear Programming (MILP) with '= int' Qualifiers", _
    "Maximize 5*u3 + 8*v3 s.t. u3 + v3 <= 6, 5*u3 + 9*v3 <= 45, u3,v3 >= 0 and Integer (LP relaxation is 41.25 at 2.25, 3.75)", _
    "LinearSolver(""GetMax = 5*u3 + 8*v3, By Changing = u3, v3, LimitingConditions = u3 + v3 <= 6, 5*u3 + 9*v3 <= 45, u3 = int, v3 = int, NonNegative"")", _
    "Integer Max = 40 at u3 = 0, v3 = 5", _
    "Integer Max = " & FormatNumber(ans3, 0) & " at u3 = " & FormatNumber(u3, 0) & ", v3 = " & FormatNumber(v3, 0), _
    ok3

' ============================================================================
' TASK 4: 0-1 Binary Knapsack with 1D Array Variable Expansion & AllBinary
' ============================================================================
Dim pick(1 To 4) As Double
pick(1) = 0 : pick(2) = 0 : pick(3) = 0 : pick(4) = 0
ans4 = LinearSolver("GetMax = 10*pick(1) + 13*pick(2) + 19*pick(3) + 31*pick(4), By Changing = pick, LimitingConditions = 2*pick(1) + 3*pick(2) + 4*pick(3) + 7*pick(4) <= 9, Options = AllBinary")
ok4 = (Abs(ans4 - 42) < 1e-6) And (Abs(pick(1) - 1) < 1e-6) And (Abs(pick(2) - 1) < 1e-6) And (Abs(pick(3) - 1) < 1e-6) And (Abs(pick(4) - 0) < 1e-6)
RecordTask 4, "0-1 Binary Knapsack with Automatic 1D Array Expansion & AllBinary", _
    "Maximize 10*pick(1)+13*pick(2)+19*pick(3)+31*pick(4) s.t. 2*pick(1)+3*pick(2)+4*pick(3)+7*pick(4) <= 9, pick(i) in {0,1}", _
    "LinearSolver(""GetMax = 10*pick(1) + 13*pick(2) + 19*pick(3) + 31*pick(4), By Changing = pick, LimitingConditions = ..., Options = AllBinary"")", _
    "Max = 42 at pick = [1, 1, 1, 0] (weights 2+3+4 = 9)", _
    "Max = " & FormatNumber(ans4, 0) & " at pick = [" & CStr(pick(1)) & ", " & CStr(pick(2)) & ", " & CStr(pick(3)) & ", " & CStr(pick(4)) & "]", _
    ok4

' ============================================================================
' TASK 5: Target Value Goal-Seek (GetValue = ...) with Free (Signed) Variables
' ============================================================================
s5 = 0 : t5 = 0
ans5 = LinearSolver("GetValue = 12, Target = 3*s5 - 2*t5, By Changing = s5, t5, LimitingConditions = s5 + t5 = 1")
ok5 = (Abs(ans5 - 12) < 1e-6) And (Abs(s5 - 2.8) < 1e-6) And (Abs(t5 - (-1.8)) < 1e-6)
RecordTask 5, "Target Value Goal-Seek (GetValue=12) with Free (Negative-Allowed) Variables", _
    "Find free variables (s5, t5) such that Target (3*s5 - 2*t5) = 12 and s5 + t5 = 1", _
    "LinearSolver(""GetValue = 12, Target = 3*s5 - 2*t5, By Changing = s5, t5, LimitingConditions = s5 + t5 = 1"")", _
    "Target = 12.0000 at s5 = 2.8000, t5 = -1.8000", _
    "Target = " & FormatNumber(ans5, 4) & " at s5 = " & FormatNumber(s5, 4) & ", t5 = " & FormatNumber(t5, 4), _
    ok5

' ============================================================================
' TASK 6: User-Defined Basic Function Objective + String Array & Double Bounds
' ============================================================================
Global p6 As Double, q6 As Double
p6 = 0 : q6 = 0
Dim conds6(1 To 3) As String
conds6(1) = "p6 + q6 <= 5"
conds6(2) = "2*p6 + q6 <= 8"
conds6(3) = "0 <= p6 <= 3.5"

ans6 = LinearSolver("GetMax, Target = ObjFunc6, By Changing = p6, q6, LimitingConditions = conds6, q6 >= 0")
ok6 = (Abs(ans6 - 26) < 1e-6) And (Abs(p6 - 3) < 1e-6) And (Abs(q6 - 2) < 1e-6)
RecordTask 6, "User-Defined Basic Function Objective + String Array & Double Bounds", _
    "Maximize Function ObjFunc6() = 6*p6 + 4*q6 s.t. conds6 array [p6+q6<=5, 2*p6+q6<=8, 0<=p6<=3.5] and q6 >= 0", _
    "LinearSolver(""GetMax, Target = ObjFunc6, By Changing = p6, q6, LimitingConditions = conds6, q6 >= 0"")", _
    "ObjFunc6 = 26.0000 at p6 = 3.0000, q6 = 2.0000", _
    "ObjFunc6 = " & FormatNumber(ans6, 4) & " at p6 = " & FormatNumber(p6, 4) & ", q6 = " & FormatNumber(q6, 4), _
    ok6

' ============================================================================
' TASK 7: Unconstrained Nonlinear Minimization (Nelder-Mead Simplex Polish)
' ============================================================================
x7 = 0 : y7 = 0
GetMin = (x7 - 3)^2 + (y7 + 2)^2 + 5
ans7 = NonlinearSolver("GetMin, By Changing = x7, y7, Algorithm = NelderMead, TimeLimit = 5 s")
ok7 = (Abs(ans7 - 5) < 1e-5) And (Abs(x7 - 3) < 1e-4) And (Abs(y7 - (-2)) < 1e-4)
RecordTask 7, "Unconstrained Nonlinear Minimization (Paraboloid Bowl via Nelder-Mead)", _
    "Minimize GetMin = (x7 - 3)^2 + (y7 + 2)^2 + 5 over R^2", _
    "NonlinearSolver(""GetMin, By Changing = x7, y7, Algorithm = NelderMead, TimeLimit = 5 s"")", _
    "GetMin = 5.0000 at x7 = 3.0000, y7 = -2.0000", _
    "GetMin = " & FormatNumber(ans7, 4) & " at x7 = " & FormatNumber(x7, 4) & ", y7 = " & FormatNumber(y7, 4), _
    ok7

' ============================================================================
' TASK 8: Constrained Nonlinear Programming (DEPS Evolutionary + Local Polish)
' ============================================================================
x8 = 1.0 : y8 = 1.5
obj8 = x8 + y8
circleCond = x8^2 + y8^2 <= 8
ans8 = NonlinearSolver("GetMax = obj8, By Changing = x8[0, 4], y8[0, 4], LimitingConditions = circleCond, Algorithm = DEPS, SwarmSize = 25, LearningCycles = 120")
ok8 = (Abs(ans8 - 4) < 1e-3) And (Abs(x8 - 2) < 1e-2) And (Abs(y8 - 2) < 1e-2)
RecordTask 8, "Constrained Nonlinear Programming (DEPS Algorithm on Disk Constraint)", _
    "Maximize x8 + y8 s.t. circleCond: x8^2 + y8^2 <= 8 with bracket bounds x8[0,4], y8[0,4]", _
    "NonlinearSolver(""GetMax = obj8, By Changing = x8[0, 4], y8[0, 4], LimitingConditions = circleCond, Algorithm = DEPS, SwarmSize = 25, LearningCycles = 120"")", _
    "Max = 4.0000 at x8 = 2.0000, y8 = 2.0000", _
    "Max = " & FormatNumber(ans8, 4) & " at x8 = " & FormatNumber(x8, 4) & ", y8 = " & FormatNumber(y8, 4), _
    ok8

' ============================================================================
' TASK 9: Nonlinear Engineering Design (Minimum-Perimeter Rectangle via SCO)
' ============================================================================
w9 = 2 : h9 = 20
perim = 2 * (w9 + h9)
areaCond = w9 * h9 >= 36
ans9 = NonlinearSolver("GetMin = perim, By Changing = w9[1, 25], h9[1, 25], LimitingConditions = areaCond, Algorithm = SCO, SwarmSize = 20, LearningCycles = 80")
ok9 = (Abs(ans9 - 24) < 1e-3) And (Abs(w9 - 6) < 1e-2) And (Abs(h9 - 6) < 1e-2)
RecordTask 9, "Nonlinear Engineering Design (Minimum-Perimeter Section via SCO)", _
    "Minimize perim = 2*(w9 + h9) s.t. areaCond: w9 * h9 >= 36, w9,h9 in [1, 25]", _
    "NonlinearSolver(""GetMin = perim, By Changing = w9[1, 25], h9[1, 25], LimitingConditions = areaCond, Algorithm = SCO, SwarmSize = 20, LearningCycles = 80"")", _
    "Min Perimeter = 24.0000 at w9 = 6.0000, h9 = 6.0000", _
    "Min Perimeter = " & FormatNumber(ans9, 4) & " at w9 = " & FormatNumber(w9, 4) & ", h9 = " & FormatNumber(h9, 4), _
    ok9

' ============================================================================
' TASK 10: Auto-Detecting Solver() + Return=Array + SOLVER.* Diagnostics
' ============================================================================
a10 = 0 : b10 = 0
resArr = Solver("GetMin = (a10 - 4)^2 + (b10 - 1)^2, By Changing = a10[0, 5], b10[0, 5], LimitingConditions = a10 + 2*b10 <= 5, Algorithm = NelderMead, Return = Array")
ok10 = (Abs(resArr(0) - 0.2) < 1e-4) And (Abs(resArr(1) - 3.8) < 1e-3) And (Abs(resArr(2) - 0.6) < 1e-3)
RecordTask 10, "Auto-Detecting Solver() with Return=Array & SOLVER.* Diagnostics", _
    "Minimize (a10 - 4)^2 + (b10 - 1)^2 s.t. a10 + 2*b10 <= 5, returning [Objective, a10, b10] array", _
    "resArr = Solver(""GetMin = (a10 - 4)^2 + (b10 - 1)^2, By Changing = a10[0, 5], b10[0, 5], LimitingConditions = a10 + 2*b10 <= 5, Return = Array"")", _
    "resArr(0) = 0.2000, resArr(1) = 3.8000, resArr(2) = 0.6000", _
    "resArr(0) = " & FormatNumber(resArr(0), 4) & ", resArr(1) = " & FormatNumber(resArr(1), 4) & ", resArr(2) = " & FormatNumber(resArr(2), 4), _
    ok10

LogLine "============================================================================"
LogLine "  VERIFICATION SUMMARY: " & CStr(passCount) & " / " & CStr(totalCount) & " TASKS PASSED"
LogLine "============================================================================"

Close #ch
